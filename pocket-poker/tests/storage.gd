extends SceneTree
const Session = preload("res://core/session.gd")
const Poker = preload("res://core/poker.gd")
const Store = preload("res://core/save_store.gd")
func _initialize():
	var dir = "user://test-" + str(Time.get_ticks_usec())
	var store = Store.new(dir)
	var s = Session.start(["One", "Two"], Poker.full_deck())
	assert(store.save_game(s) == "")
	s = Session.command(s, {"type": "deal"})
	assert(store.save_game(s) == "")
	assert(store.inspect().state.game.cursor == 1)
	var f = FileAccess.open(dir + "/game.json", FileAccess.WRITE)
	f.store_string("broken")
	f.close()
	assert(store.inspect().status == "recovery")
	assert(store.save_game(s) != "")
	assert(store.save_game(store.inspect().state, true) == "")
	assert(store.inspect().state.game.cursor == 0)
	var blocked = Store.new(dir + "/game.json/child")
	assert(blocked.save_game(s) != "", "A failed write must not report success")
	assert(store.inspect().state.game.cursor == 0)
	print("Save, damaged-file preservation and explicit recovery: passed")
	quit()
