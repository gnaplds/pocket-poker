extends SceneTree
const Session = preload("res://core/session.gd")
const Poker = preload("res://core/poker.gd")
func _initialize():
	var s = Session.start(["Alex", "Blair"], Poker.full_deck(), 0)
	for i in range(4): s = Session.command(s, {"type": "deal"})
	assert(s.phase == "public")
	s = Session.command(s, {"type": "continue"})
	s = Session.command(s, {"type": "ready"})
	s = Session.command(s, {"type": "peek", "show": true})
	assert(Session.view(s).seats[0].cards.size() == 2)
	var restored = Session.restore(Session.encode(s))
	assert(restored.phase == "handoff")
	assert(Session.view(restored).seats.all(func(p): return p.cards.is_empty()))
	s = Session.command(s, {"type": "bet", "action": "raise", "amount": 20})
	s = Session.command(s, {"type": "ready"})
	s = Session.command(s, {"type": "bet", "action": "call"})
	assert(s.voters.size() == 2 and Session.view(s).public_cards)
	for i in range(2):
		s = Session.command(s, {"type": "ready"})
		s = Session.command(s, {"type": "vote", "twice": true})
	assert(s.game.boards.size() == 2)
	while s.phase != "result":
		s = Session.command(s, {"type": "continue" if s.phase == "public" else "deal"})
	assert(s.game.stacks.reduce(func(a,b): return a+b,0) == 40)
	assert(Session.restore(Session.encode(s)).game.stacks == s.game.stacks)
	assert(Session.restore('{"version":1}').has("error"))
	# Restart while a card is in flight: continue the same deck, without a second draw.
	var partial = Session.start(["One", "Two"], Poker.full_deck())
	partial = Session.command(partial, {"type":"deal"})
	assert(not Session.view(partial).event.has("card"))
	partial = Session.restore(Session.encode(partial))
	assert(partial.phase == "public" and partial.game.cursor == 1)
	partial = Session.command(partial, {"type":"continue"})
	partial = Session.command(partial, {"type":"deal"})
	assert(Session.restore(Session.encode(partial)).game.cursor == 2)
	# A resumed private turn remains replayable through another save.
	restored = Session.command(restored, {"type":"ready"})
	restored = Session.command(restored, {"type":"bet","action":"fold"})
	assert(restored.phase == "result" and not Session.view(restored).showdown)
	assert(Session.view(restored).seats.all(func(p): return p.cards.is_empty()))
	assert(Session.restore(Session.encode(restored)).game.stacks == restored.game.stacks)
	restored = Session.command(restored, {"type":"next_hand","deck":Poker.full_deck()})
	assert(restored.hand == 2 and restored.game.button == 1 and restored.game.sb == 1 and restored.game.bb == 0)
	assert(Session.restore(Session.encode(restored)).hand == 2)
	print("Session privacy, votes, two runouts and replay: passed")
	quit()
