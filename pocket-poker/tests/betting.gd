extends SceneTree
const Poker = preload("res://core/poker.gd")
func advance(g: Dictionary, n: int) -> Dictionary:
	for i in range(n): g = Poker.deal(g)
	return g
func fixed(text: String) -> Array:
	var first = Array(text.split(" "))
	return first + Poker.full_deck().filter(func(c): return c not in first)
func finish(g: Dictionary) -> Dictionary:
	while g.stage != "showdown":
		g = Poker.deal(g)
	return Poker.showdown(g)
func _initialize():
	var short = advance(Poker.create([20,8,20],Poker.full_deck(),0),6)
	short = Poker.act(short,"raise",6)
	short = Poker.act(short,"raise",8)
	short = Poker.act(short,"call")
	assert(Poker.act(short,"raise",12).has("error"))
	var cumulative = advance(Poker.create([8,10,20,20],Poker.full_deck(),0),8)
	for amount in [6,8,10]: cumulative = Poker.act(cumulative,"raise",amount)
	cumulative = Poker.act(cumulative,"call")
	cumulative = Poker.act(cumulative,"raise",14)
	assert(cumulative.current_bet == 14 and cumulative.actor == 2)
	var opening = advance(Poker.create([20,20,3],Poker.full_deck(),0),6)
	opening = Poker.act(opening,"call")
	opening = Poker.act(opening,"call")
	opening = advance(Poker.act(opening,"check"),4)
	opening = Poker.act(opening,"check")
	opening = Poker.act(opening,"raise",1)
	assert(Poker.legal(opening).min == 3 and Poker.act(opening,"raise",2).has("error"))
	opening = Poker.act(opening,"call")
	assert(not Poker.legal(opening).can_raise)
	var pots = advance(Poker.create([20,5,12],fixed("Ac Kc Qc Ah Kh Qh 3s 2d 4h 7s 5c 9d 6c Js 2c Qd 8s Td 3c Qs 4c 7d"),0),6)
	pots = Poker.act(pots,"raise",20)
	pots = Poker.act(pots,"call")
	pots = Poker.act(pots,"call")
	assert(pots.pot == 29 and pots.returned == [8,0,0])
	var once = finish(pots)
	assert(once.stacks == [8,15,14])
	pots = finish(Poker.run_twice(pots))
	assert(pots.stacks == [22,8,7])
	assert(pots.pots[0].shares.map(func(s): return s.amount) == [8,7])
	assert(pots.pots[1].shares.map(func(s): return s.amount) == [7,7])
	var bust = advance(Poker.create([5,5,12,20],fixed("Qc Kc Jc Ac Qh Kh Jh Ah 3s 2d 4h 7s 5c 9d 6c Ts"),0),8)
	bust = Poker.act(bust,"raise",20)
	while bust.actor != -1: bust = Poker.act(bust,"call")
	bust = finish(bust)
	assert(bust.stacks == [20,0,14,8])
	bust = Poker.next_hand(bust,Poker.full_deck())
	assert(bust.button == 1 and bust.sb == 2 and bust.bb == 3)
	bust = advance(bust,6)
	assert(bust.hands[1].is_empty() and bust.actor == 0)
	print("Short raises, reopening, refunds, side pots, two-run odd chips and dead button: passed")
	quit()
